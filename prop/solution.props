<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>BVN_ASSET_ROOT=R"($(SolutionDir)/assets)";BVN_GRID_VERT_SPV=R"($(SolutionDir)/shaders/grid.vert.spv)";BVN_GRID_FRAG_SPV=R"($(SolutionDir)/shaders/grid.frag.spv)";BVN_SPRITE_VERT_SPV=R"($(SolutionDir)/shaders/sprite.vert.spv)";BVN_SPRITE_FRAG_SPV=R"($(SolutionDir)/shaders/sprite.frag.spv)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>