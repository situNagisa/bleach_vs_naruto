{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 28,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "windows-vcpkg-base",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"VCPKG_TARGET_TRIPLET": "x64-windows"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-clang-cl-debug",
			"displayName": "Windows clang-cl Debug",
			"inherits": "windows-vcpkg-base",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "windows-clang-cl-release",
			"displayName": "Windows clang-cl Release",
			"inherits": "windows-vcpkg-base",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "windows-msvc",
			"displayName": "Windows MSVC + vcpkg",
			"inherits": "windows-vcpkg-base",
			"generator": "Visual Studio 17 2022",
			"architecture": "x64",
			"binaryDir": "${sourceDir}/out/build/${presetName}"
		}
	],
	"buildPresets": [
		{
			"name": "windows-clang-cl-debug",
			"configurePreset": "windows-clang-cl-debug"
		},
		{
			"name": "windows-clang-cl-release",
			"configurePreset": "windows-clang-cl-release"
		},
		{
			"name": "windows-msvc-debug",
			"configurePreset": "windows-msvc",
			"configuration": "Debug"
		},
		{
			"name": "windows-msvc-release",
			"configurePreset": "windows-msvc",
			"configuration": "Release"
		}
	]
}
