# 工具链守卫：Clang >= 22（Linux 上 clang++ + libc++，Windows 上 clang-cl + MSVC STL）或 GCC >= 16；生成器用 Ninja。
# 编译期计算用 C++26 静态反射还是模板元编程，由编译器是否打开了反射决定（见 include/sdag/config.h 与 build_settings.cmake）。
function(sdag_check_toolchain)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 22.0)
            message(FATAL_ERROR "sdag 需要 Clang >= 22，当前：${CMAKE_CXX_COMPILER_VERSION}。")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 16.0)
            message(FATAL_ERROR "sdag 需要 GCC >= 16，当前：${CMAKE_CXX_COMPILER_VERSION}。")
        endif()
    else()
        message(FATAL_ERROR "sdag 只支持 Clang / clang-cl 与 GCC（当前：${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}）。")
    endif()
    if(NOT CMAKE_GENERATOR MATCHES "^Ninja")
        message(FATAL_ERROR "sdag 需要 Ninja / Ninja Multi-Config 生成器（当前：${CMAKE_GENERATOR}）。")
    endif()
endfunction()
