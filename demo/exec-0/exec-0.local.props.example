<?xml version="1.0" encoding="utf-8"?>
<!--
  复制为 exec-0.local.props（已被 .gitignore 忽略）后按本机修改。
  exec-0.vcxproj 会在存在时自动导入；这里设置的宏会覆盖工程里的默认值。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- LLVM 官方安装包的根目录（其下有 bin\clang-cl.exe、bin\clang-scan-deps.exe） -->
    <BvnLlvmRoot>D:\tools\LLVM</BvnLlvmRoot>
    <!-- CMake >= 4.4 的 cmake.exe；留空或删掉则用 PATH 上的 cmake -->
    <BvnCMakeExe>D:\tools\cmake\bin\cmake.exe</BvnCMakeExe>
    <!-- 第三方库根目录（其下有 stdexec\、SDL\）；默认取系统环境变量 NAGISA_LIBRARY_ROOT -->
    <BvnNagisaLibraryRoot>C:\Users\你的用户名</BvnNagisaLibraryRoot>
    <!-- nagisa 根目录；默认取系统环境变量 NAGISA_ROOT -->
    <BvnNagisaRoot>C:\Users\你的用户名\nagisa</BvnNagisaRoot>
  </PropertyGroup>
</Project>
