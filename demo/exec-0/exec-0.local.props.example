<?xml version="1.0" encoding="utf-8"?>
<!--
  复制为 exec-0.local.props（已被 .gitignore 忽略）后按本机修改。
  exec-0.vcxproj 会在存在时最先导入；这里设置的宏会覆盖工程里的默认值。不需要的行删掉即可。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <!-- LLVM 官方安装包的根目录（其下有 bin\clang-cl.exe、bin\clang-scan-deps.exe）。
         Debug / Release 经预设使用它；DebugHeaders / ReleaseHeaders 的 ClangCL 工具集用它作 LLVMInstallDir。 -->
    <BvnLlvmRoot>D:\tools\LLVM</BvnLlvmRoot>
    <!-- LLVM 主版本号（$(BvnLlvmRoot)\lib\clang\<版本> 的目录名），默认 22；升级 LLVM 后同步修改 -->
    <BvnLlvmToolsVersion>22</BvnLlvmToolsVersion>
    <!-- DebugHeaders / ReleaseHeaders 用的工具集：ClangCL（默认）或 v145（MSVC cl.exe） -->
    <BvnHeadersToolset>ClangCL</BvnHeadersToolset>
    <!-- CMake >= 4.4 的 cmake.exe；留空或删掉则用 PATH 上的 cmake（仅 Debug / Release） -->
    <BvnCMakeExe>D:\tools\cmake\bin\cmake.exe</BvnCMakeExe>
    <!-- vcpkg 根目录；默认取环境变量 VCPKG_ROOT。两类配置都用它（CMake 工具链文件 / MSBuild 集成） -->
    <BvnVcpkgRoot>D:\tools\vcpkg</BvnVcpkgRoot>
    <!-- 第三方库根目录（其下有 stdexec\、glfw\、glm\）；默认取系统环境变量 NAGISA_LIBRARY_ROOT -->
    <BvnNagisaLibraryRoot>C:\Users\你的用户名</BvnNagisaLibraryRoot>
    <!-- nagisa 根目录；默认取系统环境变量 NAGISA_ROOT -->
    <BvnNagisaRoot>C:\Users\你的用户名\nagisa</BvnNagisaRoot>
  </PropertyGroup>
</Project>
